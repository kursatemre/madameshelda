NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# Resend (e-posta bildirimleri)
RESEND_API_KEY=re_xxx...

# Admin
ADMIN_EMAIL=admin@madameshelda.com
ADMIN_PASSWORD=xxxx

# Site
NEXT_PUBLIC_SITE_URL=https://madameshelda.com

# Cron (opsiyonel — terk edilmiş sepet hatırlatma job'u)
